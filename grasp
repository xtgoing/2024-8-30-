def create_cropping_box_from_boxes(boxes, image_size, margin=20):
    # 原逻辑保持不变
    if not boxes:
        return 0, 0, image_size[0], image_size[1]
    x1_min = max(0, min(b[0] for b in boxes) - margin)
    y1_min = max(0, min(b[1] for b in boxes) - margin)
    x2_max = min(image_size[0], max(b[2] for b in boxes) + margin)
    y2_max = min(image_size[1], max(b[3] for b in boxes) + margin)
    return int(x1_min), int(y1_min), int(x2_max), int(y2_max)

def crop_pointcloud(pcd, cropping_box, color_image, depth_image, workspace_limits):
    # 原逻辑保持不变
    x1, y1, x2, y2 = cropping_box
    depth_crop = depth_image[y1:y2, x1:x2]
    color_crop = color_image[y1:y2, x1:x2]
    mask = (depth_crop > 0)
    points, colors = [], []
    for i in range(depth_crop.shape[0]):
        for j in range(depth_crop.shape[1]):
            if mask[i, j]:
                x, y = j + x1, i + y1
                z = depth_crop[i, j]
                points.append((x, y, z))
                colors.append(color_crop[i, j] / 255.0)
    points, colors = np.array(points), np.array(colors)
    # 转换到工作空间坐标系（原逻辑保持不变）
    return o3d.geometry.PointCloud()

